; @APP@'s translations for Tauri's installer message identifiers.
LangString addOrReinstall ${LANG_ENGLISH} "Repair or reinstall"
LangString alreadyInstalled ${LANG_ENGLISH} "@APP@ is already installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. Choose what you would like to do."
LangString appRunning ${LANG_ENGLISH} "@APP@ is running. Close it, then try again."
LangString appRunningOkKill ${LANG_ENGLISH} "Save your work and finish any active tasks first.$\nChoose OK to force quit @APP@ and continue."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose an option to continue."
LangString choowHowToInstall ${LANG_ENGLISH} "Choose how to install @APP@."
LangString createDesktop ${LANG_ENGLISH} "Create a desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Install over the existing version"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Install over the existing version (unavailable when downgrading)"
LangString failedToKillApp ${LANG_ENGLISH} "Couldn't close @APP@. Close it yourself, then try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2…"
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of @APP@ is installed. Using an older version may affect compatibility. Choose how to continue."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "@APP@ is already installed ($R4 version). Choose how to install the new version."
LangString silentDowngrades ${LANG_ENGLISH} "This installer cannot downgrade silently. Run the installer normally to review the available options.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Couldn't uninstall @APP@. Close @APP@ and try again."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall @APP@"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Uninstall the previous version first"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 could not be installed. @APP@ needs it to run. Try running the installer again."
LangString webview2DownloadError ${LANG_ENGLISH} "Couldn't download WebView2. Error: $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 download complete"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading WebView2…"
LangString webview2InstallError ${LANG_ENGLISH} "Couldn't install WebView2. Exit code: $1"
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 is installed"
LangString deleteAppData ${LANG_ENGLISH} "Also delete application data"
