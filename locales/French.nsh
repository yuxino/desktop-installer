; Traductions de @APP@ pour les messages de l’installateur Tauri.
LangString addOrReinstall ${LANG_FRENCH} "Réparer ou réinstaller"
LangString alreadyInstalled ${LANG_FRENCH} "@APP@ est déjà installé"
LangString alreadyInstalledLong ${LANG_FRENCH} "${PRODUCTNAME} ${VERSION} est déjà installé. Choisissez l’action à effectuer."
LangString appRunning ${LANG_FRENCH} "@APP@ est en cours d’exécution. Fermez l’application, puis réessayez."
LangString appRunningOkKill ${LANG_FRENCH} "Enregistrez votre travail et terminez les tâches actives d’abord.$\nChoisissez OK pour forcer la fermeture de @APP@ et continuer."
LangString chooseMaintenanceOption ${LANG_FRENCH} "Choisissez une option pour continuer."
LangString choowHowToInstall ${LANG_FRENCH} "Choisissez comment installer @APP@."
LangString createDesktop ${LANG_FRENCH} "Créer un raccourci sur le bureau"
LangString dontUninstall ${LANG_FRENCH} "Installer par-dessus la version existante"
LangString dontUninstallDowngrade ${LANG_FRENCH} "Installer par-dessus la version existante (indisponible pour revenir à une ancienne version)"
LangString failedToKillApp ${LANG_FRENCH} "Impossible de fermer @APP@. Fermez l’application vous-même, puis réessayez."
LangString installingWebview2 ${LANG_FRENCH} "Installation de WebView2…"
LangString newerVersionInstalled ${LANG_FRENCH} "Une version plus récente de @APP@ est installée. Une ancienne version peut affecter la compatibilité. Choisissez comment continuer."
LangString older ${LANG_FRENCH} "ancienne"
LangString olderOrUnknownVersionInstalled ${LANG_FRENCH} "@APP@ est déjà installé (version $R4). Choisissez comment installer la nouvelle version."
LangString silentDowngrades ${LANG_FRENCH} "Cet installateur ne peut pas revenir silencieusement à une ancienne version. Lancez-le normalement pour examiner les options.$\n"
LangString unableToUninstall ${LANG_FRENCH} "Impossible de désinstaller @APP@. Fermez @APP@ et réessayez."
LangString uninstallApp ${LANG_FRENCH} "Désinstaller @APP@"
LangString uninstallBeforeInstalling ${LANG_FRENCH} "Désinstaller d’abord la version précédente"
LangString unknown ${LANG_FRENCH} "inconnue"
LangString webview2AbortError ${LANG_FRENCH} "Impossible d’installer WebView2, nécessaire pour @APP@. Réessayez de lancer l’installateur."
LangString webview2DownloadError ${LANG_FRENCH} "Impossible de télécharger WebView2. Erreur : $0"
LangString webview2DownloadSuccess ${LANG_FRENCH} "Téléchargement de WebView2 terminé"
LangString webview2Downloading ${LANG_FRENCH} "Téléchargement de WebView2…"
LangString webview2InstallError ${LANG_FRENCH} "Impossible d’installer WebView2. Code de sortie : $1"
LangString webview2InstallSuccess ${LANG_FRENCH} "WebView2 est installé"
LangString deleteAppData ${LANG_FRENCH} "Supprimer aussi les données de l’application"
